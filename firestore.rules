rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 問題：每位老師只能改自己的題目，但所有登入者都能讀（學生掃 QR 要看題目）
    match /questions/{questionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.keys().hasAll(['imageUrl', 'options', 'active', 'teacherId', 'createdAt', 'expiresAt', 'roomCode']);

      // owner 才能改；teacherId 與 roomCode 不可被改寫；
      // 允許更新 votingEndsAt（倒數計時器）、requireIdentity、active、correctAnswer、showAnswer
      allow update: if request.auth != null
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.roomCode == resource.data.roomCode;

      allow delete: if request.auth != null
                    && resource.data.teacherId == request.auth.uid;
    }

    // 投票：任何登入者可寫入自己的票；read 公開（投票統計需要）；
    // 刪除限定該題的 owner（用於 resetVotes）；不允許改票
    match /votes/{voteId} {
      allow read: if request.auth != null;

      // create 必填 questionId / userId / timestamp，且需含以下三者之一：
      //   optionIndex (int) 單選 / optionIndices (list 1-20) 多選 / textAnswer (string 1-50) 簡答
      // 一人一票：票的編號必須是「題目_本人」，同一人第二張票會撞編號（變成 update）而被拒收。
      // 過渡期（舊版網頁還在學生平板快取裡）暫時接受隨機編號，2026-12-01 起自動停止；
      // 隨機編號限 20 碼英數字（Firestore 自動編號格式），避免有人搶先用別人的「題目_學生」編號卡位。
      // 不論哪種編號，題目都必須還開著：active、未過期、倒數未結束（給 5 秒網路延遲寬限）。
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['questionId', 'userId', 'timestamp'])
                    && (voteId == request.resource.data.questionId + '_' + request.auth.uid
                        || (request.time < timestamp.date(2026, 12, 1)
                            && voteId.matches('[A-Za-z0-9]{20}')))
                    && questionOpenForVoting(request.resource.data.questionId)
                    && (
                         ('optionIndex' in request.resource.data && request.resource.data.optionIndex is int)
                         ||
                         ('optionIndices' in request.resource.data
                          && request.resource.data.optionIndices is list
                          && request.resource.data.optionIndices.size() >= 1
                          && request.resource.data.optionIndices.size() <= 20)
                         ||
                         ('textAnswer' in request.resource.data
                          && request.resource.data.textAnswer is string
                          && request.resource.data.textAnswer.size() >= 1
                          && request.resource.data.textAnswer.size() <= 50)
                       )
                    && (!('voterName' in request.resource.data) || request.resource.data.voterName.size() <= 30)
                    && (!('voterSeat' in request.resource.data) || request.resource.data.voterSeat.size() <= 10);

      allow update: if false;

      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/questions/$(resource.data.questionId)).data.teacherId == request.auth.uid;
    }

    // 表情反饋（彈幕風格）：所有登入者可讀，本人才能寫；不可改、不可刪
    match /reactions/{rid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['questionId', 'emoji', 'userId', 'createdAt'])
                    && request.resource.data.emoji.size() <= 8;

      allow update: if false;
      allow delete: if false;
    }

    function questionOpenForVoting(questionId) {
      let qPath = /databases/$(database)/documents/questions/$(questionId);
      let q = get(qPath).data;
      return exists(qPath)
        && q.active == true
        && (q.get('expiresAt', null) == null || request.time < q.expiresAt)
        && (q.get('votingEndsAt', null) == null
            || request.time < q.votingEndsAt + duration.value(5, 's'));
    }

    // 其他 collection 一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
